# Copy to .env.local. Browser RPC for Sepolia (restrict the key to your domain).
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-alchemy-key>
# Optional: a node for event logs (wide block ranges). Default: a public Sepolia node. Free Alchemy keys allow only 10 blocks.
# NEXT_PUBLIC_LOGS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
